# Copy to .env for local Compose use. In Portainer, enter these under Stack environment variables.
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_KEY_ID=
WYZE_API_KEY=

# Set these to a unique broker user/password. The broker is included in this stack.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_HOST_PORT=1883

POLL_INTERVAL_SECONDS=30
DEVICE_MODEL=DWS2U
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_STATE_PREFIX=wyze
MQTT_CLIENT_ID=wyze-mqtt-bridge
